<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="XMa+ssgCc^vSD}rA*f*~" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="MgfB-D^B.We1c!~tdj(Y"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace Talker{" line1="// 喋らせて、発声完了の '&gt;' を待つ。完了で ready=1 + ハート表示" line2="function speak(msg: string, timeoutMs: number) {" line3="    ready = 0" line4="    dummy = serial.readString()" line5="    // ★CRで実行される。LFは送らない" line6="    serial.writeString(&quot;&quot; + msg + CR)" line7="    start2 = input.runningTime()" line8="    while (input.runningTime() - start2 &lt; timeoutMs) {" line9="        buf2 = &quot;&quot; + buf2 + serial.readString()" line10="        if (buf2.indexOf(&quot;&gt;&quot;) &gt;= 0) {" line11="            // 完了 → P1ランプ点灯" line12="            ready = 1" line13="            // ★readyになったらハート" line14="            basic.showIcon(IconNames.Heart)" line15="            return" line16="        }" line17="        basic.pause(10)" line18="    }" line19="    // 応答なし=異常。再同期して復帰" line20="    atpWaitReady()" line21="    ready = 1" line22="    // ★復帰後もハート" line23="    basic.showIcon(IconNames.Heart)" line24="}" line25="function atpTrySync() {" line26="    dummy = serial.readString()" line27="    // '?' 単独。CRは付けない" line28="    serial.writeString(&quot;?&quot;)" line29="    start = input.runningTime()" line30="    while (input.runningTime() - start &lt; 400) {" line31="        buf = &quot;&quot; + buf + serial.readString()" line32="        if (buf.indexOf(&quot;&gt;&quot;) &gt;= 0) {" line33="            return true" line34="        }" line35="        basic.pause(10)" line36="    }" line37="    return false" line38="}" line39="input.onButtonPressed(Button.A, function () {" line40="    if (ready == 0) {" line41="        return" line42="    }" line43="    // 挨拶中はスマイル" line44="    basic.showIcon(IconNames.Happy)" line45="    speak(&quot;konn'nichiwa,watashiwa maikurobi'tto,de'su.&quot;, 15000)" line46="})" line47="// ===== ATP3011 ヘルパー =====" line48="function atpReset() {" line49="    pins.digitalWritePin(ATP_RESET, 1)" line50="    basic.pause(5)" line51="    pins.digitalWritePin(ATP_RESET, 0)" line52="    basic.pause(20)" line53="    pins.digitalWritePin(ATP_RESET, 1)" line54="    basic.pause(120)" line55="}" line56="function atpWaitReady() {" line57="    atpReset()" line58="    while (!(atpTrySync())) {" line59="        basic.showLeds(`" line60="            . . . . ." line61="            . . . . ." line62="            . . # . ." line63="            . . . . ." line64="            . . . . ." line65="            `)" line66="        basic.pause(200)" line67="        atpReset()" line68="    }" line69="}" line70="let buf = &quot;&quot;" line71="let start = 0" line72="let buf2 = &quot;&quot;" line73="let start2 = 0" line74="let dummy = &quot;&quot;" line75="let ready = 0" line76="let CR = &quot;&quot;" line77="let ATP_RESET = 0" line78="// ──1kΩ── J4-1 (/RESET)" line79="ATP_RESET = DigitalPin.P12" line80="// ★ブロック変換でも壊れないCR" line81="CR = String.fromCharCode(13)" line82="pins.digitalWritePin(ATP_RESET, 1)" line83="serial.redirect(" line84="    SerialPin.P8," line85="    SerialPin.P16," line86="    BaudRate.BaudRate9600" line87=")" line88="serial.setRxBufferSize(64)" line89="basic.pause(50)" line90="basic.showLeds(`" line91="    . . . . ." line92="    . . . . ." line93="    . . # . ." line94="    . . . . ." line95="    . . . . ." line96="    `)" line97="// リセット→'?'→'&gt;' まで確実に" line98="atpWaitReady()" line99="ready = 1" line100="basic.showIcon(IconNames.Heart)" line101="pins.setAudioPin(DigitalPin.P15)" line102="//ここまでnamespace" line103="}" numlines="104"></mutation></block></statement></block></xml>