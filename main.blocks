<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id=")5CsQfJWMm#@2V(mssZ~" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="fMR{Bx$Mg`~=4=Fm[C*D"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace Talker{" line1="    // 喋らせて、発声完了の '&gt;' を待つ。" line2="    //% block=&quot;init&quot;" line3="    export function speak(msg: string, timeoutMs: number) {" line4="        dummy = serial.readString()" line5="        // ★CRで実行される。LFは送らない" line6="        serial.writeString(&quot;&quot; + msg + CR)" line7="        start2 = input.runningTime()" line8="        while (input.runningTime() - start2 &lt; timeoutMs) {" line9="            buf2 = &quot;&quot; + buf2 + serial.readString()" line10="            if (buf2.indexOf(&quot;&gt;&quot;) &gt;= 0) {" line11="                return" line12="            }" line13="            basic.pause(10)" line14="        }" line15="        // 応答なし=異常。再同期して復帰" line16="        atpWaitReady()" line17="    }" line18="    function atpTrySync() {" line19="        dummy = serial.readString()" line20="        // '?' 単独。CRは付けない" line21="        serial.writeString(&quot;?&quot;)" line22="        start = input.runningTime()" line23="        while (input.runningTime() - start &lt; 400) {" line24="            buf = &quot;&quot; + buf + serial.readString()" line25="            if (buf.indexOf(&quot;&gt;&quot;) &gt;= 0) {" line26="                return true" line27="            }" line28="            basic.pause(10)" line29="        }" line30="        return false" line31="    }" line32="    input.onButtonPressed(Button.A, function () {" line33="        // 挨拶中はスマイル" line34="        basic.showIcon(IconNames.Happy)" line35="        speak(&quot;konn'nichiwa,watashiwa maikurobi'tto,de'su.&quot;, 15000)" line36="        basic.showIcon(IconNames.Heart)" line37="    })" line38="    // ===== ATP3011 ヘルパー =====" line39="    function atpReset() {" line40="        pins.digitalWritePin(ATP_RESET, 1)" line41="        basic.pause(5)" line42="        pins.digitalWritePin(ATP_RESET, 0)" line43="        basic.pause(20)" line44="        pins.digitalWritePin(ATP_RESET, 1)" line45="        basic.pause(120)" line46="    }" line47="    //% block=&quot;init&quot;" line48="    export function init() {" line49="        // ──1kΩ── J4-1 (/RESET)" line50="        ATP_RESET = DigitalPin.P12" line51="        // ★ブロック変換でも壊れないCR" line52="        CR = String.fromCharCode(13)" line53="        pins.digitalWritePin(ATP_RESET, 1)" line54="        pins.setAudioPin(DigitalPin.P15)" line55="        serial.redirect(" line56="            SerialPin.P8," line57="            SerialPin.P16," line58="            BaudRate.BaudRate9600" line59="        )" line60="        serial.setRxBufferSize(64)" line61="        // リセット→'?'→'&gt;' まで確実に" line62="        atpWaitReady()" line63="        basic.pause(50)" line64="    }" line65="    function atpWaitReady() {" line66="        atpReset()" line67="        while (!(atpTrySync())) {" line68="            basic.pause(200)" line69="            atpReset()" line70="        }" line71="    }" line72="    let ATP_RESET = 0" line73="    let buf = &quot;&quot;" line74="    let start = 0" line75="    let buf2 = &quot;&quot;" line76="    let start2 = 0" line77="    let CR = &quot;&quot;" line78="    let dummy = &quot;&quot;" line79="    basic.showLeds(`" line80="    . . . . ." line81="    . . . . ." line82="    . . # . ." line83="    . . . . ." line84="    . . . . ." line85="    `)" line86="    init()" line87="    basic.showIcon(IconNames.Heart)" line88="" line89="//ここまでnamespace" line90="}" numlines="91"></mutation></block></statement></block></xml>